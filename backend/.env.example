# Copy to .env and adjust.
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/opshub
# Set PGSSL=true for managed databases that require TLS (RDS, DigitalOcean, Cloud SQL).
PGSSL=false

# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production

# Comma-separated list of allowed frontend origins (CORS + Socket.io).
CLIENT_ORIGIN=http://localhost:3000

# Phone / desktop push notifications (PWA). Generate a pair with: npm run vapid
# Keep the private key secret. Leave empty to disable push (in-app notifications still work).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourcompany.com

# Optional: email notifications when someone is tagged. Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="OpsHub <no-reply@example.com>"
# Public URL of the frontend, used in email links.
APP_URL=http://localhost:3000
