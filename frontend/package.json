  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "geist": "^1.3.1",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "wrangler": "^4.151.0"
  }
}
